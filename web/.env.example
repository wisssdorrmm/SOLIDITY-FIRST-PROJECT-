# --- Blockchain ---------------------------------------------------------
# RPC the server reads from and relays through. Local Hardhat node by default.
RPC_URL=http://127.0.0.1:8545
# Optional: overrides lib/contract.generated.json written by the deploy script.
# CONTRACT_ADDRESS=0x...
# CHAIN_ID=31337
# Wallet that submits reports for users without wallets. It must be enabled
# with setRelayer() (the deploy script does this) and hold gas money.
# The default below is Hardhat's well-known test account #0 - NEVER use it on a real network.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- AI packaging check (optional) -------------------------------------
# Without a key the app still runs OCR + rule checks + on-chain lookups.
# ANTHROPIC_API_KEY=sk-ant-...
